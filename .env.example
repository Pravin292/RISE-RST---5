NEO4J_DATABASE=csv-graph-db
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

NEO4J_URI=bolt://neo4j:7687

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=csv-rows

API_PORT=8000
UI_PORT=3000

# Optional hybrid LLM fallback for chatbot question understanding only.
# Used strictly to classify a question into a fixed Cypher template - never
# to answer it. Leave blank to run fully rule-based (no LLM at all).
ANTHROPIC_API_KEY=
CHATBOT_LLM_MODEL=claude-haiku-4-5-20251001
